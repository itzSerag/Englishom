            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LEVEL_A1\",\n  \"price\": 10000,\n  \"description\": \"Beginner level course for English learners\",\n  \"isActive\": true,\n  \"durationDays\": 30,\n  \"features\": [\"Daily lessons\", \"Grammar exercises\", \"Vocabulary practice\"]\n}",
              "options": {
