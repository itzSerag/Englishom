# ============================================================
# Englishom — Environment Variables Template
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# ============================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TZ=Asia/Riyadh

# ── MongoDB ─────────────────────────────────────────────────
# If using the bundled MongoDB container (docker-compose)
DATABASE_URL=mongodb://admin:changeme@mongodb:27017/Englishom?authSource=admin

# If using MongoDB Atlas
# DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/Englishom

# Mongo container credentials (only needed if running MongoDB via docker-compose)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DB_NAME=Englishom

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS
JWT_EXPIRATION_TIME=10d

JWT_ADMIN_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET_MIN_64_CHARS
JWT_ADMIN_EXPIRATION_TIME=10d

# ── OAuth ────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ─────────────────────────────────────────────────────
BASE_URL=https://yourdomain.com
WEBSITE_URL=https://yourfrontend.com
FRONTEND_URL=https://yourfrontend.com

# ── Paymob ───────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_INTENTION_URL=

# ── Email / Brevo ─────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_TIMEOUT_MS=180000

# ── AWS S3 ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# ── PM2 / Docker ─────────────────────────────────────────────
RUNNING_IN_DOCKER=true
